# Makar runs fully without any of these set.
# The LLM layer is strictly optional (spec 29 / 33).

MAKAR_LLM_PROVIDER=disabled        # disabled | openai | anthropic | local
MAKAR_LLM_MODEL=
MAKAR_LLM_API_KEY=
MAKAR_LLM_BASE_URL=

MAKAR_DB_PATH=out/makar.db
MAKAR_LOG_LEVEL=INFO

# --- Frontend (frontend/.env.local, not this file) ---
# CARTO basemaps require an API key. Without one the map still renders every
# forensic layer -- ports, routes, trajectories, suspicious records -- over a
# plain background, and says so on screen.
# VITE_CARTO_API_KEY=your_carto_key
